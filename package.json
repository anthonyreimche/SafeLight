{
  "name": "safelight",
  "private": true,
  "version": "2.2.0",
  "description": "Safelight — a fast RAW photo editor.",
  "homepage": "https://github.com/anthonyreimche/SafeLight",
  "desktopName": "safelight",
  "author": "Anthony Reimche <anthonyreimche@gmail.com>",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "build": "tsc && vite build",
    "build:app": "vite build",
    "preview": "vite preview",
    "icon": "node electron/make-icon.cjs",
    "electron:dev": "vite build && electron .",
    "build:electron": "npm run build:app && npm run icon && electron-builder --win",
    "build:linux": "npm run build:app && npm run icon && electron-builder --linux"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "dockview": "^6.6.1",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.3",
    "libraw-wasm": "^1.4.0",
    "png-to-ico": "^3.0.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.17.0",
    "sharp": "^0.35.1",
    "tailwindcss": "^4.3.1",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.9",
    "zustand": "^5.0.14"
  },
  "overrides": {
    "@electron/asar": "^4.2.0"
  },
  "build": {
    "appId": "com.safelight.app",
    "productName": "Safelight",
    "copyright": "Copyright © Safelight",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/main.cjs",
      "electron/preload.cjs",
      "package.json"
    ],
    "asar": true,
    "compression": "normal",
    "removePackageScripts": true,
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signtoolOptions": {
        "publisherName": [
          "Safelight"
        ]
      }
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.photography",
      "icon": "build/icon.png"
    },
    "dmg": {
      "title": "Safelight ${version}"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Graphics",
      "synopsis": "Fast RAW photo editor",
      "maintainer": "Safelight <anthonyreimche+safelight@gmail.com>",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "pacman",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "flatpak",
          "arch": [
            "x64"
          ]
        }
      ],
      "mimeTypes": [
        "image/jpeg",
        "image/png",
        "image/tiff",
        "image/webp",
        "image/x-nikon-nef",
        "image/x-nikon-nrw",
        "image/x-canon-cr2",
        "image/x-canon-cr3",
        "image/x-canon-crw",
        "image/x-sony-arw",
        "image/x-sony-sr2",
        "image/x-adobe-dng",
        "image/x-olympus-orf",
        "image/x-fuji-raf",
        "image/x-pentax-pef",
        "image/x-samsung-srw",
        "image/x-panasonic-rw2",
        "image/x-sigma-x3f",
        "image/x-dcraw"
      ]
    },
    "appImage": {
      "artifactName": "Safelight-${version}.AppImage"
    },
    "deb": {
      "packageCategory": "graphics",
      "depends": [
        "libgl1",
        "libegl1",
        "libgbm1",
        "libdrm2",
        "libnss3",
        "libgtk-3-0",
        "libxss1",
        "libglib2.0-0"
      ],
      "recommends": [
        "libvulkan1"
      ]
    },
    "flatpak": {
      "runtime": "org.freedesktop.Platform",
      "runtimeVersion": "24.08",
      "sdk": "org.freedesktop.Sdk",
      "base": "org.electronjs.Electron2.BaseApp",
      "baseVersion": "24.08"
    },
    "nsis": {
      "differentialPackage": false,
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Safelight"
    }
  },
  "dependencies": {
    "utif2": "^4.1.0"
  }
}
