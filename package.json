{
  "name": "safelight",
  "private": true,
  "version": "1.0.1",
  "description": "Safelight — a fast RAW photo editor.",
  "homepage": "https://github.com/anthonyreimche/SafeLight",
  "desktopName": "safelight",
  "author": "Anthony Reimche <anthonyreimche@gmail.com>",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "icon": "node electron/make-icon.cjs",
    "electron:dev": "vite build && electron .",
    "build:electron": "npm run build && npm run icon && electron-builder --win"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "dockview": "^6.6.1",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.2",
    "libraw-wasm": "^1.1.2",
    "png-to-ico": "^3.0.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.16.0",
    "sharp": "^0.33.5",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.2",
    "vite": "^8.0.12",
    "zustand": "^5.0.14"
  },
  "build": {
    "appId": "com.safelight.app",
    "productName": "Safelight",
    "copyright": "Copyright © Safelight",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/main.cjs",
      "electron/preload.cjs"
    ],
    "asar": true,
    "compression": "normal",
    "removePackageScripts": true,
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.ico",
      "signtoolOptions": {
        "publisherName": ["Safelight"]
      }
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        }
      ],
      "category": "public.app-category.photography",
      "icon": "build/icon.png"
    },
    "dmg": {
      "title": "Safelight ${version}"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Graphics",
      "synopsis": "Fast RAW photo editor",
      "maintainer": "Safelight <anthonyreimche+safelight@gmail.com>"
    },
    "flatpak": {
      "runtimeVersion": "24.08",
      "baseVersion": "24.08"
    },
    "nsis": {
      "differentialPackage": false,
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Safelight"
    }
  }
}
