{
  "name": "safelight",
  "private": true,
  "version": "3.2.0",
  "description": "Safelight — a fast RAW photo editor.",
  "homepage": "https://github.com/anthonyreimche/SafeLight",
  "desktopName": "safelight",
  "author": "Anthony Reimche <anthonyreimche@gmail.com>",
  "license": "GPL-3.0-only",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "test:webgl": "vitest run --config vitest.webgl.config.ts",
    "build": "tsc && vite build",
    "build:app": "vite build",
    "preview": "vite preview",
    "icon": "node electron/make-icon.cjs",
    "electron:dev": "vite build && electron .",
    "build:electron": "npm run build:app && npm run icon && electron-builder --win",
    "build:linux": "npm run build:app && npm run icon && electron-builder --linux"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "dockview": "^6.6.1",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^29.1.1",
    "libraw-wasm": "^1.4.0",
    "playwright": "^1.62.0",
    "png-to-ico": "^3.0.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.17.0",
    "sharp": "^0.35.1",
    "tailwindcss": "^4.3.1",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.10",
    "zustand": "^5.0.14"
  },
  "overrides": {
    "@electron/asar": "^4.2.0"
  },
  "build": {
    "appId": "com.safelight.app",
    "productName": "Safelight",
    "copyright": "Copyright © 2026 Anthony Reimche",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/main.cjs",
      "electron/app-protocol.cjs",
      "electron/atomic-write.cjs",
      "electron/crash-recovery.cjs",
      "electron/extension-origins.cjs",
      "electron/extension-store/install.cjs",
      "electron/extension-store/readme.cjs",
      "electron/extension-store/registry.cjs",
      "electron/extension-store/releases.cjs",
      "electron/extension-store/search.cjs",
      "electron/extension-store/thumbnails.cjs",
      "electron/extension-store/trust.cjs",
      "electron/file-range.cjs",
      "electron/gpu-backend.cjs",
      "electron/ipc/diagnostics.cjs",
      "electron/ipc/extensions.cjs",
      "electron/ipc/fs.cjs",
      "electron/ipc/index.cjs",
      "electron/ipc/window.cjs",
      "electron/issue-link.cjs",
      "electron/official-extensions.json",
      "electron/os-open.cjs",
      "electron/photo-types.json",
      "electron/plugin-files.cjs",
      "electron/plugin-releases.cjs",
      "electron/registry-cache.cjs",
      "electron/registry-entry.cjs",
      "electron/remote-json-cache.cjs",
      "electron/self-update.cjs",
      "electron/unzip.cjs",
      "electron/window-bounds.cjs",
      "electron/window-policy.cjs",
      "electron/preload.cjs",
      "package.json"
    ],
    "extraResources": [
      "LICENSE",
      "NOTICE",
      "THIRD-PARTY-NOTICES.md",
      "LICENSING.md",
      "PRIVACY.md",
      "TRADEMARKS.md",
      "EXTENSIONS.md"
    ],
    "asar": true,
    "compression": "normal",
    "removePackageScripts": true,
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signtoolOptions": {
        "publisherName": [
          "Safelight"
        ]
      }
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.photography",
      "icon": "build/icon.png",
      "fileAssociations": [
        {
          "ext": [
            "jpg",
            "jpeg",
            "png",
            "webp",
            "avif",
            "tiff",
            "tif",
            "ppm",
            "pgm",
            "pbm",
            "pnm"
          ],
          "name": "Photo",
          "role": "Editor",
          "rank": "Alternate"
        },
        {
          "ext": [
            "nef",
            "cr2",
            "cr3",
            "arw",
            "dng",
            "orf",
            "raf",
            "pef",
            "srw",
            "rw2",
            "iiq",
            "3fr",
            "nrw",
            "kdc",
            "mos",
            "mrw",
            "erf",
            "sr2",
            "x3f",
            "srf",
            "dcr",
            "rwl",
            "fff",
            "gpr",
            "mef",
            "crw",
            "raw",
            "mdc"
          ],
          "name": "RAW photo",
          "role": "Editor",
          "rank": "Alternate"
        }
      ]
    },
    "dmg": {
      "title": "Safelight ${version}"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Graphics",
      "synopsis": "Fast RAW photo editor",
      "maintainer": "Safelight <anthonyreimche+safelight@gmail.com>",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "pacman",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "flatpak",
          "arch": [
            "x64"
          ]
        }
      ],
      "mimeTypes": [
        "image/jpeg",
        "image/png",
        "image/tiff",
        "image/webp",
        "image/avif",
        "image/x-portable-pixmap",
        "image/x-portable-graymap",
        "image/x-portable-bitmap",
        "image/x-portable-anymap",
        "image/x-nikon-nef",
        "image/x-nikon-nrw",
        "image/x-canon-cr2",
        "image/x-canon-cr3",
        "image/x-canon-crw",
        "image/x-sony-arw",
        "image/x-sony-sr2",
        "image/x-sony-srf",
        "image/x-adobe-dng",
        "image/x-olympus-orf",
        "image/x-fuji-raf",
        "image/x-pentax-pef",
        "image/x-samsung-srw",
        "image/x-panasonic-rw2",
        "image/x-sigma-x3f",
        "image/x-phaseone-iiq",
        "image/x-hasselblad-3fr",
        "image/x-hasselblad-fff",
        "image/x-kodak-kdc",
        "image/x-kodak-dcr",
        "image/x-leaf-mos",
        "image/x-minolta-mrw",
        "image/x-epson-erf",
        "image/x-leica-rwl",
        "image/x-gopro-gpr",
        "image/x-mamiya-mef",
        "image/x-dcraw"
      ]
    },
    "appImage": {
      "artifactName": "Safelight-${version}.AppImage"
    },
    "deb": {
      "packageCategory": "graphics",
      "depends": [
        "libgl1",
        "libegl1",
        "libgbm1",
        "libdrm2",
        "libnss3",
        "libgtk-3-0",
        "libxss1",
        "libglib2.0-0",
        "libnotify4",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libasound2 | libasound2t64",
        "libglib2.0-bin"
      ],
      "recommends": [
        "libvulkan1"
      ],
      "executableArgs": [
        "%F"
      ]
    },
    "rpm": {
      "executableArgs": [
        "%F"
      ]
    },
    "pacman": {
      "executableArgs": [
        "%F"
      ]
    },
    "flatpak": {
      "runtime": "org.freedesktop.Platform",
      "runtimeVersion": "24.08",
      "sdk": "org.freedesktop.Sdk",
      "base": "org.electronjs.Electron2.BaseApp",
      "baseVersion": "24.08",
      "finishArgs": [
        "--socket=wayland",
        "--socket=x11",
        "--share=ipc",
        "--device=dri",
        "--socket=pulseaudio",
        "--filesystem=home",
        "--share=network",
        "--talk-name=org.freedesktop.Notifications",
        "--filesystem=/media",
        "--filesystem=/run/media",
        "--filesystem=/mnt"
      ]
    },
    "nsis": {
      "differentialPackage": false,
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Safelight",
      "include": "build/installer.nsh",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp"
    }
  },
  "dependencies": {
    "utif2": "^4.1.0"
  }
}
