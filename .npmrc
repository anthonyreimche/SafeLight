# Skip auto-installing optional peer deps. app-builder-lib lists
# electron-builder-squirrel-windows (Windows Squirrel target, unused here —
# we build nsis/AppImage/deb/dmg) as a peerDependency, which drags in the
# deprecated electron-winstaller -> temp -> rimraf@2 -> glob@7 -> inflight chain.
legacy-peer-deps=true
